#!/bin/sh
# Enroll a known PIN and the inserted SIM privately; never submit the PIN.
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
CONFIG=/etc/sim-pin-unlock
RUNTIME=/tmp/sim-pin-unlock
CLI=/usr/bin/mipc_wan_cli
TIMEOUT=/usr/bin/timeout
tty_mode=
stage=
locked=0
profile=
stdio=0
prompt_channel=/dev/tty
if [ "${1-}" = --stdin ]; then
    stdio=1
    prompt_channel=/dev/stdout
    shift
fi
profile_name=${1-}
carrier=legacy
apn=
roaming=unchanged

[ "$#" -le 1 ] || { printf '%s\n' 'Usage: enroll-sim-pin [--stdin] [profile-name]' >&2; exit 1; }
if [ -n "$profile_name" ]; then
    case "$profile_name" in
        *[!a-zA-Z0-9_-]*|-*|_*) printf '%s\n' 'Use a profile name starting with a letter or digit, followed by letters, digits, - or _.' >&2; exit 1;;
    esac
    [ "${#profile_name}" -le 48 ] || exit 1
    profile="$CONFIG/profiles/$profile_name"
fi

die() {
    printf '%s\n' "$1" >&2
    exit 1
}

read_answer() {
    if [ "$stdio" = 1 ]; then
        IFS= read -r "$1"
    else
        IFS= read -r "$1" < /dev/tty
    fi
}

validate_apn() {
    case "$carrier" in
        digi|o2|custom)
            case "$apn" in
                ''|*[!a-zA-Z0-9.-]*|.*|*.) die 'APN must contain only letters, digits, hyphens and dots, without a leading or trailing dot.';;
            esac
            [ "${#apn}" -le 100 ] || die 'APN is too long.'
            ;;
        unchanged|legacy) [ -z "$apn" ] || die 'Invalid saved APN choice.';;
        *) die 'Invalid saved carrier choice.';;
    esac
    case "$roaming" in
        enabled|disabled|carrier|unchanged) ;;
        *) die 'Invalid saved roaming choice.';;
    esac
}

choose_apn() {
    printf '%s\n' 'Choose APN guidance for this SIM profile:' \
        '  1) DIGI Spain: internet.digimobil.es, data roaming enabled' \
        '  2) O2 Spain: telefonica.es, PAP, username/password telefonica' \
        '  3) Custom APN' \
        '  4) Keep current APN settings' \
        'The choice is saved as guidance; apply it in the router web panel.' > "$prompt_channel"
    printf 'Carrier [1-4]: ' > "$prompt_channel"
    read_answer choice || exit 1
    case "$choice" in
        1) carrier=digi; apn=internet.digimobil.es; roaming=enabled;;
        2) carrier=o2; apn=telefonica.es; roaming=carrier;;
        3)
            carrier=custom
            printf 'Custom APN: ' > "$prompt_channel"
            read_answer apn || exit 1
            printf 'Data roaming [y/n]: ' > "$prompt_channel"
            read_answer choice || exit 1
            case "$choice" in
                y|Y|yes|YES) roaming=enabled;;
                n|N|no|NO) roaming=disabled;;
                *) die 'Choose y or n for data roaming.';;
            esac
            ;;
        4) carrier=unchanged; apn=; roaming=unchanged;;
        *) die 'Choose a carrier from 1 to 4; no enrollment was changed.';;
    esac
    validate_apn
}

show_apn() {
    case "$carrier" in
        legacy) printf '%s\n' 'No APN choice is saved in this older profile; keep the current router settings.'; return;;
        unchanged) printf '%s\n' 'APN choice: keep the current router settings.'; return;;
    esac
    printf 'Apply in the router web panel: APN %s; mobile data enabled.\n' "$apn"
    case "$carrier" in
        o2) printf '%s\n' 'Authentication: PAP; username/password: telefonica.';;
    esac
    case "$roaming" in
        enabled|disabled) printf 'Data roaming: %s.\n' "$roaming";;
        carrier) printf '%s\n' 'Data roaming: follow your carrier requirements.';;
    esac
    printf '%s\n' 'APN guidance saved; the router APN settings have not been changed.'
}

cleanup() {
    result=$?
    trap - EXIT
    if [ -n "$tty_mode" ]; then
        stty "$tty_mode" < /dev/tty 2>/dev/null || :
    fi
    [ -z "$stage" ] || rm -rf "$stage"
    [ "$locked" = 0 ] || rmdir "$RUNTIME/lock" 2>/dev/null
    exit "$result"
}

identity() {
    "$TIMEOUT" -s KILL 12 "$CLI" --at_cmd 'AT+CCID' 2>/dev/null |
        awk '/^[ \t]*\+CCID:/ {
            sub(/^[ \t]*\+CCID:[ \t]*/, "")
            gsub(/[ \t\r]/, "")
            sub(/[fF]$/, "")
            if ($0 ~ /^[0-9]+$/ && length($0) >= 18 && length($0) <= 22)
                print
        }'
}

[ "$(id -u)" = 0 ] || die 'Run this on the router as root.'
[ -x "$CLI" ] && [ -x "$TIMEOUT" ] || die 'Required modem tools are missing.'
[ -z "$profile" ] || [ ! -L "$CONFIG/profiles" ] || die 'Invalid profiles directory.'
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
mkdir -p "$RUNTIME" || exit 1
chmod 700 "$RUNTIME" || exit 1
mkdir "$RUNTIME/lock" 2>/dev/null || die 'Another enrollment or verification is running.'
locked=1
[ ! -e "$CONFIG/verification.pending" ] || die 'A previous operation is unconfirmed. Review it before re-enrolling.'

state=$("$TIMEOUT" -s KILL 12 "$CLI" --show_sim_status 2>/dev/null | tr -d '\r\n')
case "$state" in
    MIPC_SIM_STATUS_SIM_PIN) ;;
    MIPC_SIM_STATUS_READY|MIPC_SIM_STATUS_COMPLETE_READY)
        protection=$("$TIMEOUT" -s KILL 12 "$CLI" --at_cmd 'AT+CLCK="SC",2' 2>/dev/null | tr -d '\r')
        printf '%s\n' "$protection" | grep -q '^+CLCK: 1$' ||
            die 'Enable SIM PIN protection on a phone first; this firmware can lock cards with protection off.'
        ;;
    *) die 'SIM must be ready or waiting for its PIN. Do not use this for PUK recovery.';;
esac

iccid=$(identity)
case "$iccid" in ''|*[!0-9]*) die 'Could not read exactly one SIM identity; no enrollment was changed.';; esac
[ "${#iccid}" -ge 18 ] && [ "${#iccid}" -le 22 ] || die 'Invalid SIM identity.'
if [ -n "$profile" ] && { [ -e "$profile" ] || [ -L "$profile" ]; }; then
    [ -d "$profile" ] && [ ! -L "$profile" ] || die 'Invalid profile directory.'
    for name in pin iccid; do
        [ -f "$profile/$name" ] && [ ! -L "$profile/$name" ] || die 'Profile is incomplete or contains a symbolic link.'
    done
    [ "$(cat "$profile/iccid")" = "$iccid" ] || die 'This profile belongs to another SIM. Use that card or a new profile name.'
    pin=$(cat "$profile/pin") || exit 1
    if [ -e "$profile/carrier" ] || [ -e "$profile/apn" ] || [ -e "$profile/roaming" ]; then
        for name in carrier apn roaming; do
            [ -f "$profile/$name" ] && [ ! -L "$profile/$name" ] || die 'Saved APN guidance is incomplete or contains a symbolic link.'
        done
        carrier=$(cat "$profile/carrier") || exit 1
        apn=$(cat "$profile/apn") || exit 1
        roaming=$(cat "$profile/roaming") || exit 1
        validate_apn
    fi
else
    if [ "$stdio" = 0 ]; then
        tty_mode=$(stty -g < /dev/tty 2>/dev/null) || die 'A terminal is required. Use router-cli from your computer.'
    fi
    [ -z "$profile" ] || choose_apn
    if [ "$stdio" = 0 ]; then
        stty -echo < /dev/tty || die 'Could not hide terminal input.'
    fi
    printf 'Known working SIM PIN (hidden): ' > "$prompt_channel"
    read_answer pin || exit 1
    printf '\nRepeat PIN (hidden): ' > "$prompt_channel"
    read_answer repeat || exit 1
    printf '\n' > "$prompt_channel"
    if [ "$stdio" = 0 ]; then
        stty "$tty_mode" < /dev/tty || exit 1
        tty_mode=
    fi
    [ "$pin" = "$repeat" ] || die 'PIN entries differ; no enrollment was changed.'
fi
case "$pin" in ''|*[!0-9]*) die 'PIN must contain 4 to 8 decimal digits.';; esac
[ "${#pin}" -ge 4 ] && [ "${#pin}" -le 8 ] || die 'PIN must contain 4 to 8 decimal digits.'
[ "$(identity)" = "$iccid" ] || die 'SIM changed during enrollment; stopping.'

mkdir -p "$CONFIG" || exit 1
chmod 700 "$CONFIG" || exit 1
stage=$(mktemp -d "$CONFIG/.enroll.XXXXXX") || exit 1
printf '%s\n' "$pin" > "$stage/pin" || exit 1
printf '%s\n' "$iccid" > "$stage/iccid" || exit 1
pin=
repeat=
chmod 600 "$stage/pin" "$stage/iccid" || exit 1
if [ -n "$profile" ] && [ ! -e "$profile" ]; then
    [ ! -L "$CONFIG/profiles" ] || die 'Invalid profiles directory.'
    mkdir -p "$CONFIG/profiles" "$stage/profile" || exit 1
    chmod 700 "$CONFIG/profiles" "$stage/profile" || exit 1
    cp "$stage/pin" "$stage/profile/pin" || exit 1
    cp "$stage/iccid" "$stage/profile/iccid" || exit 1
    printf '%s\n' "$carrier" > "$stage/profile/carrier" || exit 1
    printf '%s\n' "$apn" > "$stage/profile/apn" || exit 1
    printf '%s\n' "$roaming" > "$stage/profile/roaming" || exit 1
fi

# Use the persistent stop guard while updating the pair. A crash must not
# leave the service able to use a new identity with the previous card's PIN.
(set -C; : > "$CONFIG/verification.pending") 2>/dev/null || exit 1
sync
for name in pin iccid; do
    if [ -f "$CONFIG/$name" ]; then
        cp "$CONFIG/$name" "$CONFIG/$name.previous" || exit 1
        chmod 600 "$CONFIG/$name.previous" || exit 1
    fi
    mv "$stage/$name" "$CONFIG/$name" || exit 1
done
if [ -d "$stage/profile" ]; then
    mv "$stage/profile" "$profile" || exit 1
fi
sync
rm -f "$CONFIG/verification.pending" || exit 1
sync
if [ -n "$profile_name" ]; then
    printf 'Selected SIM profile: %s\n' "$profile_name"
    show_apn
fi
printf '%s\n' 'SIM enrolled. No PIN was submitted. Enrollment does not verify PIN correctness.'
printf '%s\n' 'Keep any attempt marker from this boot; the startup service will run on the next boot.'
